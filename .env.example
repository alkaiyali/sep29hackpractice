# Meddy — optional Firebase configuration for Care Circle live sync.
#
# Copy this file to `.env` and fill in the values from your Firebase project:
#   Firebase console → Project settings → Your apps → Web app → SDK setup
#
# Leave them blank to run Meddy fully offline (local-only Care Circle),
# which is the default for the hackathon demo.
#
# After editing, restart the bundler with a cleared cache:
#   npx expo start -c

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
